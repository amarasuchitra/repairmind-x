  "research": [
   {
    "topic": "Traction on slopes",
    "explanation": "Split gravity into components along and normal to the ramp. The along-ramp part must be beaten by traction; the normal part sets how much traction friction can give (μ·N). The rover climbs only if tanθ < μ, independent of mass.",
    "key_equations": [
     "F = m·g·(sinθ + C_rr·cosθ)",
     "tanθ < μ"
    ],
    "further_reading": [
     "Wong, Theory of Ground Vehicles",
     "Gillespie, Fundamentals of Vehicle Dynamics"
    ]
   },
   {
    "topic": "Static stability",
    "explanation": "A body on a slope stays upright while its centre of mass projects inside the support polygon. Lowering the CG or widening the base raises the tip angle; dynamic loads (braking) shift the effective gravity vector and reduce it.",
    "key_equations": [
     "θ_tip = atan(b / h)"
    ],
    "further_reading": [
     "Siegwart, Introduction to Autonomous Mobile Robots"
    ]
   }
  ],
  "open_questions": [
   "What is the real friction coefficient of the ramp surface when oily?",
   "Is there a lip at the bottom of the ramp the wheels must climb?"
  ],
