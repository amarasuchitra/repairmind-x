    "id": "R1",
    "text": "Climb a 10° ramp at 0.5 m/s with payload",
    "kind": "performance",
    "verification": "analysis",
    "rationale": "Steepest ramp in the plant"
   },
   {
    "id": "R2",
    "text": "Not tip over on the ramp, including when braking",
    "kind": "safety",
    "verification": "analysis",
    "rationale": "A falling rover can hurt people"
   },
   {
    "id": "R3",
    "text": "Run for at least 2 hours per charge",
    "kind": "performance",
    "verification": "analysis",
    "rationale": "One full inspection shift"
   },
   {
    "id": "R4",
    "text": "Demonstrate the climb on the real ramp before release",
    "kind": "performance",
    "verification": "test",
    "rationale": "Analysis assumes friction we must confirm"
   }
  ],
