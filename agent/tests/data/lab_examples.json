   {
    "id": "E1",
    "name": "Climbing force",
    "symbol": "F_climb",
    "expression": "m * g0 * (sin(theta) + C_rr * cos(theta))",
    "unit": "N",
    "explanation": "On a slope, gravity has a component m·g·sinθ along the ramp, and rolling resistance adds C_rr times the normal force m·g·cosθ. At steady speed the wheels must push with the sum.",
    "assumptions": "Steady speed, no aerodynamic drag at 0.5 m/s",
    "requirement_id": "R1",
    "check": {
     "kind": "none",
     "limit": 0,
     "limit_unit": "",
     "factor_of_safety": 1,
     "label": ""
    }
   },
   {
    "id": "E2",
    "name": "Torque per wheel",
    "symbol": "tau_w",
    "expression": "F_climb * r / n_w",
    "unit": "N*m",
    "explanation": "Each wheel turns its share of the traction force into torque through its radius: τ = F·r / n.",
    "assumptions": "Load shared equally between wheels",
    "requirement_id": "R1",
    "check": {
     "kind": "max",
     "limit": 2,
     "limit_unit": "N*m",
     "factor_of_safety": 2,
     "label": "within motor peak torque, FS 2"
    }
   },
   {
    "id": "E3",
    "name": "Ground speed",
    "symbol": "v",
    "expression": "omega_w * r",
    "unit": "m/s",
    "explanation": "With no slip, the contact patch is momentarily at rest, so the axle moves at ω·r.",
    "assumptions": "No slip",
    "requirement_id": "R1",
    "check": {
     "kind": "min",
     "limit": 0.5,
     "limit_unit": "m/s",
     "factor_of_safety": 1,
     "label": "at least 0.5 m/s"
    }
   },
   {
    "id": "E4",
    "name": "Tip-over angle",
    "symbol": "theta_tip",
    "expression": "atan(b / h_cg)",
    "unit": "deg",
    "explanation": "The rover tips when the gravity vector through the centre of mass passes outside the downhill wheel contact, at tanθ = b / h.",
    "assumptions": "Static, rigid suspension",
    "requirement_id": "R2",
    "check": {
     "kind": "min",
     "limit": 10,
     "limit_unit": "deg",
     "factor_of_safety": 2,
     "label": "twice the ramp angle"
    }
   },
   {
    "id": "E5",
    "name": "Climbing power",
    "symbol": "P_climb",
    "expression": "F_climb * v / eta",
    "unit": "W",
    "explanation": "Mechanical power is force times speed; divide by efficiency for the electrical power drawn.",
    "assumptions": "",
    "requirement_id": "R3",
    "check": {
     "kind": "none",
     "limit": 0,
     "limit_unit": "",
     "factor_of_safety": 1,
     "label": ""
    }
   },
   {
    "id": "E6",
    "name": "Endurance",
    "symbol": "t_run",
    "expression": "E_batt / (P_climb + P_aux)",
    "unit": "h",
