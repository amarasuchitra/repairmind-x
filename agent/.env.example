# LiveKit Cloud project (cloud.livekit.io > Settings > Keys)
LIVEKIT_URL=wss://repairmind-jedd2lf4.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google AI Studio key for Gemini Live (aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Anthropic API key for the second-model safety cross-check (console.anthropic.com)
# Without it, amber and irreversible steps are blocked (fails closed).
ANTHROPIC_API_KEY=

# Optional
RMX_GEMINI_MODEL=gemini-3.1-flash-live-preview
RMX_GEMINI_VOICE=Charon
RMX_REVIEW_MODEL=claude-opus-5-5
RMX_ALLOWED_ORIGINS=http://localhost:5173
# Required by iFixit from 1 Jan 2027; commercial use needs their paid plan
IFIXIT_API_KEY=

# Bulk inspection API (web app "Bulk inspection" page). Leave empty to keep it disabled.
# Pick any long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
RMX_INSPECTION_TOKEN=
