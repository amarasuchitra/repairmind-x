# LiveKit Cloud project (cloud.livekit.io > Settings > Keys)
LIVEKIT_URL=wss://repairmind-jedd2lf4.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google AI Studio key for Gemini Live (aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Second-opinion review, label reading, part markers (live AR) and camera step checks.
# FREE by default: with only GOOGLE_API_KEY set, these use a separate Gemini model on the free tier.
# Optional paid upgrade: set ANTHROPIC_API_KEY and Claude does them instead (a fully independent model).
# With neither, risky steps are blocked (fails closed).
ANTHROPIC_API_KEY=
# auto (default) | gemini | anthropic | off
RMX_CHECK_PROVIDER=auto
RMX_GEMINI_CHECK_MODEL=gemini-3.5-flash

# Optional
RMX_GEMINI_MODEL=gemini-3.1-flash-live-preview
RMX_GEMINI_VOICE=Charon
RMX_REVIEW_MODEL=claude-opus-5-5
# Design lab engineer (Claude if ANTHROPIC_API_KEY is set, else free Gemini)
RMX_DESIGN_MODEL=claude-opus-5-5
# Interface translation model when ANTHROPIC_API_KEY is set (otherwise the free Gemini check model is used)
RMX_TRANSLATE_MODEL=claude-opus-5-5
# 1 = also pass the speech language code to Gemini Live (native-audio models pick it themselves)
RMX_GEMINI_SET_LANGUAGE=0
RMX_ALLOWED_ORIGINS=http://localhost:5173
# Required by iFixit from 1 Jan 2027; commercial use needs their paid plan
IFIXIT_API_KEY=

# Bulk inspection API (web app "Bulk inspection" page). Leave empty to keep it disabled.
# Pick any long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
RMX_INSPECTION_TOKEN=
